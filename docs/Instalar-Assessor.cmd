@echo off
title Instalador do Assessor - UNICIVE
echo Abrindo o instalador do Assessor. Aguarde...
set "UNICIVE_"
set "UNICIVE_LAUNCHER=1"
powershell -NoProfile -ExecutionPolicy Bypass -STA -Command "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $f = Join-Path $env:TEMP 'instalador-assessor.ps1'; try { Invoke-WebRequest 'https://raw.githubusercontent.com/lfcanhete/unicive-hermes/main/instalador.ps1' -OutFile $f -UseBasicParsing -ErrorAction Stop } catch { Write-Host ''; Write-Host 'Nao consegui baixar o instalador do GitHub.' -ForegroundColor Red; Write-Host $_.Exception.Message; Write-Host 'A rede pode estar bloqueando o github.com. Tente em outra rede (por exemplo, o roteador do celular).'; exit 1 }; & $f; if (-not $global:UniciveJanelaAbriu) { Write-Host ''; Write-Host 'A janela do instalador nao abriu.' -ForegroundColor Red; $Error | Select-Object -First 5 | ForEach-Object { Write-Host $_ }; exit 1 }"
if errorlevel 1 pause
